<%#
# Phase 15F.1: SHARED branded email body — the SINGLE source of truth rendered BOTH in the composer's final
# preview AND by Bloomwire::EmailTestMailer#template_email (HTML part). One partial => the delivered email
# always matches the preview. Inline styles only (email-client safe). No secrets are involved here.
# locals: body (String, already variable-interpolated), cta_label (String/nil), cta_url (String/nil), year (Integer)
%>
<div style="margin:0;padding:0;background:#f4f4f7;">
  <div style="max-width:600px;margin:0 auto;padding:24px 12px;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
    <div style="text-align:center;padding:8px 0 20px;">
      <span style="font-size:22px;font-weight:700;color:#7c3aed;letter-spacing:.5px;">Bloomwire</span>
    </div>
    <div style="background:#ffffff;border:1px solid #e5e7eb;border-radius:12px;padding:32px;">
      <div style="font-size:15px;line-height:1.6;color:#1f2937;">
        <%= simple_format(body.to_s) %>
      </div>
      <%# Phase 15F.6: email-safe CTA button. Rendered ONLY when the (resolved) URL is an absolute http(s)://
          link — a scheme-less/relative href is neutralized by email clients (button degrades to raw text), and
          the send/preview already block that case. Table + td bgcolor is the email-client-robust button pattern
          (Outlook/Gmail/Apple Mail); inline styles only; label + href are HTML-escaped by <%%=. %>
      <% if cta_label.to_s.present? && Bloomwire::EmailTemplate.absolute_cta_url?(cta_url) %>
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:28px auto 4px;">
          <tr>
            <td align="center" bgcolor="#7c3aed" style="border-radius:8px;">
              <a href="<%= cta_url %>" target="_blank" rel="nofollow noopener"
                 style="display:inline-block;background:#7c3aed;color:#ffffff;text-decoration:none;padding:12px 30px;border-radius:8px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:600;line-height:1.2;">
                <%= cta_label %>
              </a>
            </td>
          </tr>
        </table>
      <% end %>
    </div>
    <div style="text-align:center;color:#9ca3af;font-size:12px;line-height:1.6;padding:18px 0 4px;">
      &copy; <%= year %> Bloomwire. All rights reserved.<br>
      Help Center &middot; Privacy Policy &middot; Terms of Service
    </div>
  </div>
</div>
