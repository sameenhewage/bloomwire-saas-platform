<%#
# Flash Partial — renders flash messages on every page using Bloomwire alert styling.
%>
<% if flash.any? %>
  <div class="bw-flashes">
    <% flash.each do |key, value| -%>
      <% next if value.blank? %>
      <div class="bw-flash bw-flash--<%= key %>" role="alert"><%= value.to_s.html_safe %></div>
    <% end -%>
  </div>
<% end %>
