<li>
  <details class="bw-nav-group" <%= 'open' if open %>>
    <summary class="bw-nav-item <%= 'is-active' if open %>">
      <svg width="16" height="16"><use xlink:href="#icon-settings-2-line" /></svg>
      <%= link_to 'Settings', super_admin_settings_url, class: 'flex-1', style: 'color: inherit; text-decoration: none;' %>
      <svg class="bw-nav-group__chevron" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </summary>
    <ul class="bw-nav-sub">
      <% settings_pages.each do |_feature_key, attrs| %>
        <%= render partial: 'nav_item', locals: {
              url: super_admin_app_config_url(config: attrs['config_key']),
              label: attrs['name'],
            } %>
      <% end %>
    </ul>
  </details>
</li>
