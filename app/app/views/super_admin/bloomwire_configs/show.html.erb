<% content_for(:title) do %>
  Bloomwire / Unecast Features
<% end %>
<% content_for(:breadcrumb) do %>
  <%= bw_crumbs('Bloomwire', 'Features') %>
<% end %>

<div class="bw-page-head">
  <div>
    <h1 class="bw-page-title">Bloomwire Features</h1>
    <p class="bw-page-subtitle">
      Master switch for the Bloomwire/Unecast layer. While OFF, every sub-feature is inert and tenant-facing
      behavior is stock Chatwoot. This page is always reachable so the layer can be enabled from the UI.
    </p>
  </div>
  <span class="bw-badge <%= @master_enabled ? 'bw-badge--success' : 'bw-badge--neutral' %>">
    <span class="bw-badge__dot"></span><%= @master_enabled ? 'Mode ON' : 'Mode OFF' %>
  </span>
</div>

<%= form_with url: super_admin_bloomwire_config_url, method: :post do |form| %>
  <div class="bw-card">
    <h2 class="bw-card__title">Master switch</h2>
    <p class="bw-card__subtitle">Bootstrap control — reachable even when OFF. AND-gates every sub-feature below.</p>
    <div class="bw-field bw-field--sm mb-0">
      <%= form.label "bloomwire_config[#{@master_key}]", 'Bloomwire Mode (master)', class: 'bw-label' %>
      <%= form.select "bloomwire_config[#{@master_key}]",
        [['True', true], ['False', false]],
        { selected: @master_enabled },
        class: 'bw-select' %>
    </div>
  </div>

  <div class="bw-card">
    <h2 class="bw-card__title">Sub-features</h2>
    <% unless @master_enabled %>
      <div class="bw-blocked mb-4">
        <div><span class="bw-blocked__title">Bloomwire Mode is OFF.</span> Sub-features are disabled until the master toggle is ON.</div>
      </div>
    <% end %>

    <fieldset <%= 'disabled' unless @master_enabled %> class="p-0 m-0 border-0">
      <% @sub_features.each do |feature, key| %>
        <% privacy_locked = @privacy_dependent.include?(feature) && !@privacy_enabled %>
        <div class="bw-field bw-field--md">
          <%= form.label "bloomwire_config[#{key}]", key.delete_prefix('BLOOMWIRE_').titleize, class: 'bw-label' %>
          <%= form.select "bloomwire_config[#{key}]",
            [['True', true], ['False', false]],
            { selected: Bloomwire::Features.raw_enabled?(feature) },
            class: 'bw-select',
            disabled: privacy_locked %>
          <% if @privacy_dependent.include?(feature) %>
            <p class="bw-help">Managed-data feature — requires Privacy hardening ON before it can take effect (fail-closed).</p>
          <% end %>
        </div>
      <% end %>
    </fieldset>
  </div>

  <div class="mt-4">
    <%= form.submit 'Save changes', class: 'bw-btn bw-btn--primary' %>
  </div>
<% end %>
