<% content_for(:title) do %>
  WhatsApp Setups
<% end %>
<% content_for(:breadcrumb) do %>
  <%= bw_crumbs('Bloomwire', ['WhatsApp Setups', super_admin_bloomwire_whatsapp_setups_path], 'All Setups') %>
<% end %>

<div class="bw-page-head">
  <div>
    <h1 class="bw-page-title">WhatsApp Setups</h1>
    <p class="bw-page-subtitle">
      Read-only status of managed WhatsApp inboxes — setup readiness and non-secret routing identifiers;
      credentials live on the channel and are never shown here. Customers set up WhatsApp from their own account
      (Settings → Inboxes → Add Inbox); this surface no longer creates or edits mappings.
    </p>
  </div>
</div>

<div class="bw-card bw-card--flush">
  <% if @setups.empty? %>
    <div class="bw-empty">
      <span class="bw-empty__icon"><svg width="22" height="22"><use xlink:href="#icon-whatsapp-line" /></svg></span>
      <p class="bw-empty__title">No managed WhatsApp inboxes yet</p>
      <p class="bw-empty__text">Customers connect WhatsApp from their own account (Settings → Inboxes → Add Inbox).
        Connected inboxes appear here as read-only status.</p>
    </div>
  <% else %>
    <table class="bw-table">
      <thead>
        <tr>
          <th>ID</th><th>Account</th><th>Inbox</th><th>Channel</th><th>Status</th>
          <th>Readiness</th><th>Request</th><th>Phone Number ID</th><th>Display Number</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% @setups.each do |setup| %>
          <% readiness = @readiness[setup] %>
          <% blocked = readiness[:status] == 'blocked' %>
          <% linked = @linked_setup_ids.include?(setup.id) %>
          <tr>
            <td><%= setup.id %></td>
            <td><%= setup.account_id %></td>
            <td><%= setup.inbox_id || '—' %></td>
            <td><%= setup.channel_whatsapp_id || '—' %></td>
            <td><%= bw_status_badge(setup.setup_status) %></td>
            <td>
              <span class="bw-badge <%= blocked ? 'bw-badge--danger' : 'bw-badge--success' %>" data-readiness="<%= readiness[:status] %>">
                <%= blocked ? 'Blocked' : 'Ready' %>
              </span>
            </td>
            <td>
              <span class="bw-badge bw-badge--neutral" data-request="<%= linked ? 'linked' : 'unlinked' %>">
                <%= linked ? 'Linked' : 'Unlinked' %>
              </span>
            </td>
            <td class="font-mono text-xs"><%= readiness[:masked][:phone_number_id] %></td>
            <td class="font-mono text-xs"><%= readiness[:masked][:display_phone_number] %></td>
            <td class="whitespace-nowrap">
              <%= link_to 'View', super_admin_bloomwire_whatsapp_setup_path(setup), class: 'bw-link' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
