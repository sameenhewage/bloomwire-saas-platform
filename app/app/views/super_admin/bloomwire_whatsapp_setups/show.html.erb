<% content_for(:title) do %>
  WhatsApp Setup Mapping #<%= @setup.id %>
<% end %>
<% content_for(:breadcrumb) do %>
  <%= bw_crumbs('Bloomwire', ['WhatsApp Setups', super_admin_bloomwire_whatsapp_setups_path], "Setup ##{@setup.id}") %>
<% end %>

<% blocked = @readiness[:status] == 'blocked' %>

<div class="bw-page-head">
  <div>
    <h1 class="bw-page-title">WhatsApp Setup #<%= @setup.id %></h1>
    <p class="bw-page-subtitle">Status: <%= bw_status_badge(@setup.setup_status) %></p>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <%= link_to 'Real-hop readiness', readiness_super_admin_bloomwire_whatsapp_setup_path(@setup), class: 'bw-btn bw-btn--primary' %>
    <% if @setup.channel_whatsapp_id.present? %>
      <%= link_to 'Channel credentials', credentials_super_admin_bloomwire_whatsapp_setup_path(@setup), class: 'bw-btn bw-btn--secondary' %>
    <% end %>
    <%= link_to 'Edit', edit_super_admin_bloomwire_whatsapp_setup_path(@setup), class: 'bw-btn bw-btn--secondary' %>
    <%= link_to 'Back', super_admin_bloomwire_whatsapp_setups_path, class: 'bw-btn bw-btn--ghost' %>
  </div>
</div>

<div class="bw-card">
  <h2 class="bw-card__title">Operational readiness</h2>
  <div class="flex flex-wrap items-center gap-3" style="margin-bottom: 12px;">
    <span class="bw-badge <%= blocked ? 'bw-badge--danger' : 'bw-badge--success' %>" data-readiness="<%= @readiness[:status] %>">
      <%= blocked ? 'Blocked' : 'Ready' %>
    </span>
    <span class="bw-badge bw-badge--neutral" data-request="<%= @request_linked ? 'linked' : 'unlinked' %>">
      Request: <%= @request_linked ? 'Linked' : 'Unlinked' %>
    </span>
  </div>
  <ul class="text-sm" style="color: var(--bw-text-secondary);">
    <li>Ready for inbound webhook mapping: <strong><%= @readiness[:ready_for_inbound_mapping] ? 'Ready' : 'Blocked' %></strong></li>
    <li>Ready for GET verification config: <strong><%= @readiness[:ready_for_get_verification_config] ? 'Ready' : 'Blocked' %></strong></li>
  </ul>
  <p class="bw-help">Full real-hop checklist on the
    <%= link_to 'readiness page', readiness_super_admin_bloomwire_whatsapp_setup_path(@setup), class: 'bw-link' %>.</p>
</div>

<div class="bw-card">
  <h2 class="bw-card__title">Details</h2>
  <dl class="text-sm">
    <% {
      'Account ID' => @setup.account_id,
      'Inbox ID' => @setup.inbox_id,
      'WhatsApp Channel ID' => @setup.channel_whatsapp_id,
      'Setup Status' => @setup.setup_status.titleize,
      'WABA ID' => @setup.waba_id,
      'Phone Number ID (masked)' => @readiness[:masked][:phone_number_id],
      'Display Phone Number (masked)' => @readiness[:masked][:display_phone_number],
      'Status Reason / Notes' => @setup.status_reason
    }.each do |label, value| %>
      <div class="flex py-2.5" style="border-bottom: 1px solid var(--bw-border-soft);">
        <dt class="w-56 shrink-0" style="color: var(--bw-text-muted);"><%= label %></dt>
        <dd style="color: var(--bw-text);"><%= value.presence || '—' %></dd>
      </div>
    <% end %>
  </dl>
  <p class="bw-help" style="margin-top: 16px;">
    Credentials (API key / webhook verify token) are stored only on the WhatsApp channel and are intentionally
    not displayed on this Ops surface.
  </p>
</div>
