<% content_for(:title) do %>
  WhatsApp Setup Mapping #<%= @setup.id %>
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title"><%= content_for(:title) %></h1>
  <div>
    <%= link_to 'Edit', edit_super_admin_bloomwire_whatsapp_setup_path(@setup), class: 'button' %>
    <%= link_to 'Back', super_admin_bloomwire_whatsapp_setups_path, class: 'button button--secondary ml-2' %>
  </div>
</header>

<section class="main-content__body">
  <dl class="text-sm">
    <% {
      'Account ID' => @setup.account_id,
      'Inbox ID' => @setup.inbox_id,
      'WhatsApp Channel ID' => @setup.channel_whatsapp_id,
      'Setup Status' => @setup.setup_status.titleize,
      'WABA ID' => @setup.waba_id,
      'Phone Number ID' => @setup.phone_number_id,
      'Display Phone Number' => @setup.display_phone_number,
      'Status Reason / Notes' => @setup.status_reason
    }.each do |label, value| %>
      <div class="flex py-2 border-b border-slate-50">
        <dt class="w-56 text-slate-500"><%= label %></dt>
        <dd><%= value.presence || '—' %></dd>
      </div>
    <% end %>
  </dl>

  <p class="mt-6 text-xs italic text-slate-400">
    Credentials (API key / webhook verify token) are stored only on the WhatsApp channel and are intentionally
    not displayed on this Ops surface.
  </p>
</section>
