<% content_for(:title) do %>
  WhatsApp Channel Credentials — Setup #<%= @setup.id %>
<% end %>

<%
  config = @channel.provider_config.to_h
  mask = ->(value) { value.to_s.strip.present? ? "****#{value.to_s.strip.last(4)}" : 'Not set' }
  api_key_state = config['api_key'].to_s.strip.present? ? 'Set' : 'Not set'
%>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title"><%= content_for(:title) %></h1>
  <div>
    <%= link_to 'Real-hop readiness', readiness_super_admin_bloomwire_whatsapp_setup_path(@setup), class: 'button button--secondary' %>
    <%= link_to 'Back', super_admin_bloomwire_whatsapp_setup_path(@setup), class: 'button button--secondary ml-2' %>
  </div>
</header>

<section class="main-content__body">
  <% if @credential_error.present? %>
    <div class="mb-6 text-sm text-red-400"><%= @credential_error %></div>
  <% end %>

  <div class="mb-6 p-4 rounded border border-slate-200 bg-slate-50 text-xs text-slate-600">
    <p>Ops-only credential entry for the linked WhatsApp channel (account #<%= @channel.account_id %>, channel #<%= @channel.id %>).</p>
    <ul class="list-disc pl-4 mt-2">
      <li>The access token (API key) is <strong>write-only</strong>: it is never displayed — only whether it is set. Leave a field blank to keep the current value.</li>
      <li>Stored encrypted at rest and scrubbed from business-facing APIs (Bloomwire privacy hardening).</li>
      <li>This screen does <strong>not</strong> call Meta and does <strong>not</strong> register webhooks; inbound stays on the global router. Run the readiness console after saving.</li>
    </ul>
  </div>

  <dl class="text-sm mb-6">
    <% {
      'Channel phone number (masked)' => mask.call(@channel.phone_number.to_s.delete_prefix('+')),
      'Access token (API key)' => api_key_state,
      'Phone Number ID (masked)' => mask.call(config['phone_number_id']),
      'Business Account ID (masked)' => mask.call(config['business_account_id']),
      'Setup mapping Phone Number ID (masked)' => mask.call(@setup.phone_number_id)
    }.each do |label, value| %>
      <div class="flex py-2 border-b border-slate-50">
        <dt class="w-72 text-slate-500"><%= label %></dt>
        <dd><%= value %></dd>
      </div>
    <% end %>
  </dl>

  <%= form_with url: update_credentials_super_admin_bloomwire_whatsapp_setup_path(@setup), method: :patch do |form| %>
    <div class="flex mb-6">
      <div class="field-unit__label"><%= form.label 'provider_config_api_key', 'Access token (API key)' %></div>
      <div class="-mt-2 field-unit__field">
        <%= form.password_field 'provider_config[api_key]', id: 'provider_config_api_key', value: nil,
              autocomplete: 'new-password', placeholder: 'Enter to set/rotate; leave blank to keep current',
              class: 'mt-2 border border-slate-100 p-1.5 rounded-md w-96' %>
        <p class="pt-2 text-xs italic text-slate-400">Write-only. Currently: <strong><%= api_key_state %></strong>. Leave blank to keep the current token.</p>
      </div>
    </div>

    <div class="flex mb-6">
      <div class="field-unit__label"><%= form.label 'provider_config_phone_number_id', 'Phone Number ID (non-secret)' %></div>
      <div class="-mt-2 field-unit__field">
        <%= form.text_field 'provider_config[phone_number_id]', id: 'provider_config_phone_number_id', value: nil,
              placeholder: 'Leave blank to keep current', class: 'mt-2 border border-slate-100 p-1.5 rounded-md w-96' %>
        <p class="pt-2 text-xs italic text-slate-400">Must match the setup mapping's Phone Number ID. Leave blank to keep current.</p>
      </div>
    </div>

    <div class="flex mb-6">
      <div class="field-unit__label"><%= form.label 'provider_config_business_account_id', 'Business Account ID (non-secret)' %></div>
      <div class="-mt-2 field-unit__field">
        <%= form.text_field 'provider_config[business_account_id]', id: 'provider_config_business_account_id', value: nil,
              placeholder: 'Leave blank to keep current', class: 'mt-2 border border-slate-100 p-1.5 rounded-md w-96' %>
        <p class="pt-2 text-xs italic text-slate-400">Leave blank to keep current.</p>
      </div>
    </div>

    <div class="form-actions">
      <%= form.submit 'Save credentials' %>
    </div>
  <% end %>
</section>
