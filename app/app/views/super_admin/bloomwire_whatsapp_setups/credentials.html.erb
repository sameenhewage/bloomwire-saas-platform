<% content_for(:title) do %>
  WhatsApp Channel Credentials — Setup #<%= @setup.id %>
<% end %>
<% content_for(:breadcrumb) do %>
  <%= bw_crumbs('Bloomwire', ['WhatsApp Setups', super_admin_bloomwire_whatsapp_setups_path],
                ["Setup ##{@setup.id}", super_admin_bloomwire_whatsapp_setup_path(@setup)], 'Credentials') %>
<% end %>

<%
  config = @channel.provider_config.to_h
  mask = ->(value) { value.to_s.strip.present? ? "****#{value.to_s.strip.last(4)}" : 'Not set' }
  api_key_state = config['api_key'].to_s.strip.present? ? 'Set' : 'Not set'
%>

<div class="bw-page-head">
  <div>
    <h1 class="bw-page-title">Channel Credentials</h1>
    <p class="bw-page-subtitle">Setup #<%= @setup.id %> — Ops-only credential entry (write-only).</p>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <%= link_to 'Real-hop readiness', readiness_super_admin_bloomwire_whatsapp_setup_path(@setup), class: 'bw-btn bw-btn--secondary' %>
    <%= link_to 'Back', super_admin_bloomwire_whatsapp_setup_path(@setup), class: 'bw-btn bw-btn--ghost' %>
  </div>
</div>

<% if @credential_error.present? %>
  <div class="bw-error-state mb-4"><div><%= @credential_error %></div></div>
<% end %>

<div class="bw-card bw-card--form-lg">
  <h2 class="bw-card__title">Current values (masked)</h2>
  <p class="bw-card__subtitle">
    Account #<%= @channel.account_id %>, channel #<%= @channel.id %>. The access token is <strong>write-only</strong>
    (never displayed — only whether it is set), stored encrypted at rest and scrubbed from business-facing APIs.
    This screen does <strong>not</strong> call Meta and does <strong>not</strong> register webhooks.
  </p>
  <dl class="text-sm">
    <% {
      'Channel phone number (masked)' => mask.call(@channel.phone_number.to_s.delete_prefix('+')),
      'Access token (API key)' => api_key_state,
      'Phone Number ID (masked)' => mask.call(config['phone_number_id']),
      'Business Account ID (masked)' => mask.call(config['business_account_id']),
      'Setup mapping Phone Number ID (masked)' => mask.call(@setup.phone_number_id)
    }.each do |label, value| %>
      <div class="bw-dl__row">
        <dt class="bw-dl__key w-72"><%= label %></dt>
        <dd class="bw-dl__value"><%= value %></dd>
      </div>
    <% end %>
  </dl>
</div>

<div class="bw-card bw-card--form-lg">
  <h2 class="bw-card__title">Update credentials</h2>
  <p class="bw-card__subtitle">Leave a field blank to keep its current value. Run the readiness console after saving.</p>

  <%= form_with url: update_credentials_super_admin_bloomwire_whatsapp_setup_path(@setup), method: :patch do |form| %>
    <div class="bw-field">
      <%= form.label 'provider_config_api_key', 'Access token (API key)', class: 'bw-label' %>
      <%= form.password_field 'provider_config[api_key]', id: 'provider_config_api_key', value: nil,
            autocomplete: 'new-password', placeholder: 'Enter to set/rotate; leave blank to keep current',
            class: 'bw-input' %>
      <p class="bw-help">Write-only. Currently: <strong><%= api_key_state %></strong>. Leave blank to keep the current token.</p>
    </div>

    <div class="bw-field">
      <%= form.label 'provider_config_phone_number_id', 'Phone Number ID (non-secret)', class: 'bw-label' %>
      <%= form.text_field 'provider_config[phone_number_id]', id: 'provider_config_phone_number_id', value: nil,
            placeholder: 'Leave blank to keep current', class: 'bw-input' %>
      <p class="bw-help">Must match the setup mapping's Phone Number ID. Leave blank to keep current.</p>
    </div>

    <div class="bw-field">
      <%= form.label 'provider_config_business_account_id', 'Business Account ID (non-secret)', class: 'bw-label' %>
      <%= form.text_field 'provider_config[business_account_id]', id: 'provider_config_business_account_id', value: nil,
            placeholder: 'Leave blank to keep current', class: 'bw-input' %>
      <p class="bw-help">Leave blank to keep current.</p>
    </div>

    <%= form.submit 'Save credentials', class: 'bw-btn bw-btn--primary' %>
  <% end %>
</div>
