<%= form_with model: @setup, url: url, method: method do |form| %>
  <% if @setup.errors.any? %>
    <div class="bw-error-state mb-4">
      <ul class="list-disc pl-4">
        <% @setup.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bw-field">
    <%= form.label :account_id, 'Account ID', class: 'bw-label' %>
    <%= form.number_field :account_id, class: 'bw-input' %>
  </div>

  <div class="bw-field">
    <%= form.label :inbox_id, 'Inbox ID (optional)', class: 'bw-label' %>
    <%= form.number_field :inbox_id, class: 'bw-input' %>
  </div>

  <div class="bw-field">
    <%= form.label :channel_whatsapp_id, 'WhatsApp Channel ID (optional)', class: 'bw-label' %>
    <%= form.number_field :channel_whatsapp_id, class: 'bw-input' %>
  </div>

  <div class="bw-field">
    <%= form.label :setup_status, 'Setup Status', class: 'bw-label' %>
    <%= form.select :setup_status,
      Bloomwire::WhatsappSetup::SETUP_STATUSES.map { |status| [status.titleize, status] },
      {}, class: 'bw-select' %>
  </div>

  <div class="bw-field">
    <%= form.label :waba_id, 'WABA ID (non-secret)', class: 'bw-label' %>
    <%= form.text_field :waba_id, class: 'bw-input' %>
  </div>

  <div class="bw-field">
    <%= form.label :phone_number_id, 'Phone Number ID (non-secret)', class: 'bw-label' %>
    <%= form.text_field :phone_number_id, class: 'bw-input' %>
  </div>

  <div class="bw-field">
    <%= form.label :display_phone_number, 'Display Phone Number', class: 'bw-label' %>
    <%= form.text_field :display_phone_number, class: 'bw-input' %>
  </div>

  <div class="bw-field">
    <%= form.label :status_reason, 'Status Reason / Notes', class: 'bw-label' %>
    <%= form.text_area :status_reason, rows: 3, class: 'bw-input' %>
  </div>

  <p class="bw-help mb-5">
    Secrets (API key / webhook verify token) are never entered or stored here &mdash; they live in the
    WhatsApp channel configuration and stay protected by Bloomwire privacy hardening.
  </p>

  <%= form.submit 'Save setup mapping', class: 'bw-btn bw-btn--primary' %>
<% end %>
