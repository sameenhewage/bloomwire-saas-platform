<% content_for(:title) do %>
  Edit WhatsApp Setup Mapping
<% end %>
<% content_for(:breadcrumb) do %>
  <%= bw_crumbs('Bloomwire', ['WhatsApp Setups', super_admin_bloomwire_whatsapp_setups_path],
                ["Setup ##{@setup.id}", super_admin_bloomwire_whatsapp_setup_path(@setup)], 'Edit') %>
<% end %>

<div class="bw-page-head">
  <div><h1 class="bw-page-title">Edit setup mapping #<%= @setup.id %></h1></div>
  <%= link_to 'Back', super_admin_bloomwire_whatsapp_setup_path(@setup), class: 'bw-btn bw-btn--ghost' %>
</div>

<div class="bw-card bw-card--form">
  <%= render 'form', url: super_admin_bloomwire_whatsapp_setup_path(@setup), method: :patch %>
</div>
