<% content_for(:title) do %>
  WhatsApp Real-Hop Readiness — Setup #<%= @setup.id %>
<% end %>
<% content_for(:breadcrumb) do %>
  <%= bw_crumbs('Bloomwire', ['WhatsApp Setups', super_admin_bloomwire_whatsapp_setups_path],
                ["Setup ##{@setup.id}", super_admin_bloomwire_whatsapp_setup_path(@setup)], 'Readiness') %>
<% end %>

<% groups = {
  'feature_toggles' => 'Feature toggles',
  'secrets_config'  => 'Secrets / config',
  'setup_mapping'   => 'Setup mapping',
  'channel_alignment' => 'Channel alignment',
  'callback_url'    => 'Callback URL'
} %>

<div class="bw-page-head">
  <div>
    <h1 class="bw-page-title">Real-Hop Readiness</h1>
    <p class="bw-page-subtitle">Setup #<%= @setup.id %> — operational readiness checklist (read-only).</p>
  </div>
  <%= link_to 'Back to setup', super_admin_bloomwire_whatsapp_setup_path(@setup), class: 'bw-btn bw-btn--secondary' %>
</div>

<div class="bw-card">
  <% blocked = @readiness[:status] == 'blocked' %>
  <div class="mb-6 p-4 rounded border <%= blocked ? 'border-red-200 bg-red-50' : 'border-green-200 bg-green-50' %>"
       data-overall-status="<%= @readiness[:status] %>">
    <p class="text-lg font-semibold <%= blocked ? 'text-red-700' : 'text-green-700' %>">
      Overall: <%= blocked ? 'Blocked' : 'Ready' %>
    </p>
    <ul class="mt-2 text-sm text-slate-600">
      <li>Ready for inbound webhook mapping:
        <strong><%= @readiness[:ready_for_inbound_mapping] ? 'Ready' : 'Blocked' %></strong></li>
      <li>Ready for GET verification config:
        <strong><%= @readiness[:ready_for_get_verification_config] ? 'Ready' : 'Blocked' %></strong></li>
    </ul>
  </div>

  <div class="mb-6 text-sm">
    <p class="text-slate-500">Masked routing identifiers (this setup):</p>
    <ul class="mt-1 text-slate-700">
      <li>Phone Number ID: <code><%= @readiness[:masked][:phone_number_id] %></code></li>
      <li>Channel phone number: <code><%= @readiness[:masked][:channel_phone_number] %></code></li>
      <li>Display phone number: <code><%= @readiness[:masked][:display_phone_number] %></code></li>
    </ul>
  </div>

  <% groups.each do |group_key, group_label| %>
    <% checks = @readiness[:checks].select { |c| c['group'] == group_key || c[:group] == group_key } %>
    <% next if checks.empty? %>
    <h2 class="mt-6 mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500"><%= group_label %></h2>
    <ul class="text-sm">
      <% checks.each do |c| %>
        <% pass = (c[:status] || c['status']) == 'pass' %>
        <li class="flex items-start py-2 border-b border-slate-50">
          <span class="w-20 shrink-0 font-semibold <%= pass ? 'text-green-600' : 'text-red-600' %>">
            <%= pass ? 'PASS' : 'BLOCKED' %>
          </span>
          <span class="text-slate-700">
            <%= (c[:key] || c['key']).to_s.humanize %>
            <% message = c[:message] || c['message'] %>
            <% if message.present? %>
              <span class="block text-red-600"><%= message %></span>
            <% end %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% registration_prereq_keys = %w[global_webhook_router_enabled privacy_hardening_enabled
                                   global_verify_token_configured app_secret_configured
                                   public_callback_host_configured] %>
  <% check_by_key = @readiness[:checks].index_by { |c| (c[:key] || c['key']).to_s } %>
  <% registration_ready = @readiness[:ready_for_get_verification_config] %>

  <h2 class="mt-8 mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Global webhook registration readiness</h2>
  <div data-registration-readiness="<%= registration_ready ? 'ready' : 'blocked' %>"
       class="p-4 rounded border <%= registration_ready ? 'border-green-200 bg-green-50' : 'border-red-200 bg-red-50' %>">
    <p class="text-sm font-semibold <%= registration_ready ? 'text-green-700' : 'text-red-700' %>">
      GET verification prerequisites: <%= registration_ready ? 'Ready to register' : 'Blocked' %>
    </p>
    <ul class="mt-2 text-sm">
      <% registration_prereq_keys.each do |key| %>
        <% check = check_by_key[key] %>
        <% pass = check && (check[:status] || check['status']) == 'pass' %>
        <li data-prereq="<%= key %>" data-prereq-status="<%= pass ? 'pass' : 'blocked' %>" class="flex items-start py-1">
          <span class="w-20 shrink-0 font-semibold <%= pass ? 'text-green-600' : 'text-red-600' %>">
            <%= pass ? 'PASS' : 'BLOCKED' %>
          </span>
          <span class="text-slate-700"><%= key.humanize %>
            <% msg = check && (check[:message] || check['message']) %>
            <% if msg.present? %><span class="block text-red-600"><%= msg %></span><% end %>
          </span>
        </li>
      <% end %>
    </ul>

    <p class="mt-3 text-slate-700 text-sm">Callback path (copy into the Meta dashboard):</p>
    <input type="text" readonly value="<%= @readiness[:callback_path] %>"
           class="mt-1 w-full max-w-md px-2 py-1 border border-slate-200 rounded font-mono text-xs" />
    <% if @readiness[:callback_url].present? %>
      <p class="mt-2 text-slate-700 text-sm">Full callback URL:</p>
      <input type="text" readonly value="<%= @readiness[:callback_url] %>"
             class="mt-1 w-full max-w-md px-2 py-1 border border-slate-200 rounded font-mono text-xs" />
    <% else %>
      <p class="mt-2 text-red-600 text-sm">No public HTTPS host documented yet — set
        <code>BLOOMWIRE_WHATSAPP_PUBLIC_CALLBACK_HOST</code> (a non-secret hostname) to build the full URL.</p>
    <% end %>
  </div>

  <h2 class="mt-8 mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Register the callback in Meta (manual)</h2>
  <ol class="text-sm text-slate-700 list-decimal ml-5 space-y-1">
    <li>In the Meta dashboard, set the webhook callback URL to the full URL above (or the path on your public HTTPS host).</li>
    <li>Use the configured global verify token (<code>BLOOMWIRE_WHATSAPP_GLOBAL_VERIFY_TOKEN</code>) — its value is never shown here.</li>
    <li>Subscribe the app to the <strong>messages</strong> field.</li>
    <li>Confirm Meta's GET verification returns 200 with the challenge, then run the live-hop checklist.</li>
  </ol>
  <p class="mt-2 text-xs text-slate-500">
    Full operational steps: <code>projects/bloomwire-chatwoot-platform/docs/ops/whatsapp-webhook-deployment-runbook.md</code>.
  </p>

  <div class="mt-8 p-4 rounded border border-amber-200 bg-amber-50 text-sm text-amber-800">
    <p class="font-semibold">Warnings</p>
    <ul class="mt-1 list-disc ml-5 space-y-1">
      <li>No real Meta end-to-end test has been performed by this console.</li>
      <li>Do not paste real secrets, tokens, or full phone numbers into reports or screenshots.</li>
      <li>The real inbound test stays blocked until a Meta test WABA, phone_number_id, display number,
          Meta dashboard access, and a physical test phone are available.</li>
    </ul>
  </div>
</div>
