<%#
# Phase 15F: live email preview. Renders the selected template's subject/body/CTA with sample variable data
# (Bloomwire::EmailTemplate::SAMPLE_VARS) inside a branded email shell. Read-only; no secrets involved.
# locals: template (Bloomwire::EmailTemplate or nil), sample_vars (Hash)
%>
<div class="bw-panel">
  <div class="bw-panel__head">
    <h2 class="bw-panel__title">Email Preview</h2>
    <span class="bw-btn bw-btn--secondary bw-btn--sm" style="cursor:default;">Preview with Sample Data</span>
  </div>

  <% if template.nil? %>
    <div class="bw-empty">
      <p class="bw-empty__text">Save the template to see a preview with sample data.</p>
    </div>
  <% else %>
    <div class="bw-preview">
      <div class="bw-preview__email">
        <div class="bw-preview__brand">
          <%= image_tag('/brand-assets/logo_thumbnail.svg', alt: 'Bloomwire') %>
          <span>Bloomwire</span>
        </div>
        <div class="bw-preview__body"><%= template.render_body(sample_vars) %></div>
        <% if template.cta? %>
          <div style="text-align:center;">
            <a class="bw-preview__cta" href="<%= template.render_cta_url(sample_vars) %>" rel="nofollow noopener" target="_blank"><%= template.cta_label %></a>
          </div>
        <% end %>
        <div class="bw-preview__footer">
          &copy; <%= Date.current.year %> Bloomwire. All rights reserved.<br>
          <a href="#">Help Center</a> &middot; <a href="#">Privacy Policy</a> &middot; <a href="#">Terms of Service</a>
        </div>
      </div>
    </div>

    <div class="bw-panel__actions">
      <% if template.active? %>
        <%= button_to 'Deactivate', deactivate_super_admin_bloomwire_email_template_path(template), method: :patch,
                      class: 'bw-btn bw-btn--ghost', form: { data: { turbo_confirm: 'Deactivate this template?' } } %>
      <% else %>
        <%= button_to 'Reactivate', reactivate_super_admin_bloomwire_email_template_path(template), method: :patch,
                      class: 'bw-btn bw-btn--secondary' %>
      <% end %>
      <%= button_to 'Duplicate', duplicate_super_admin_bloomwire_email_template_path(template), method: :post,
                    class: 'bw-btn bw-btn--secondary' %>
      <%= link_to 'Send Test Email', super_admin_bloomwire_email_settings_path(tab: 'test_email'), class: 'bw-btn bw-btn--primary' %>
    </div>
  <% end %>
</div>
