<% content_for(:title) do %>
  WhatsApp Setup Requests
<% end %>
<% content_for(:breadcrumb) do %>
  <%= bw_crumbs('Bloomwire', ['WhatsApp Setups', super_admin_bloomwire_whatsapp_setups_path], 'WhatsApp Requests') %>
<% end %>

<div class="bw-page-head">
  <div>
    <h1 class="bw-page-title">WhatsApp Requests</h1>
    <p class="bw-page-subtitle">
      Managed WhatsApp setup requests from business accounts. Ops works each request through its status and, when
      ready, links it to a setup mapping. Credentials are never part of this request flow.
    </p>
  </div>
</div>

<div class="bw-card" style="padding: 0; overflow: hidden;">
  <% if @requests.empty? %>
    <div class="bw-empty">
      <span class="bw-empty__icon"><svg width="22" height="22"><use xlink:href="#icon-message-line" /></svg></span>
      <p class="bw-empty__title">No setup requests yet</p>
      <p class="bw-empty__text">Managed WhatsApp setup requests from business accounts will appear here.</p>
    </div>
  <% else %>
    <table class="bw-table">
      <thead>
        <tr>
          <th>ID</th><th>Account</th><th>Requested by</th><th>Status</th><th>Reason</th>
          <th>Setup mapping</th><th>Requested</th><th>Updated</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% @requests.each do |request| %>
          <tr>
            <td><%= request.id %></td>
            <td><%= request.account_id %></td>
            <td><%= request.requested_by_id || '—' %></td>
            <td><%= bw_status_badge(request.status) %></td>
            <td><%= request.status_reason.presence || '—' %></td>
            <td><%= request.bloomwire_whatsapp_setup_id || 'Pending' %></td>
            <td class="whitespace-nowrap"><%= request.created_at.to_fs(:short) %></td>
            <td class="whitespace-nowrap"><%= request.updated_at.to_fs(:short) %></td>
            <td><%= link_to 'View', super_admin_bloomwire_whatsapp_setup_request_path(request), class: 'bw-link' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
