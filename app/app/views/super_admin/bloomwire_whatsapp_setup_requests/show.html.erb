<% content_for(:title) do %>
  WhatsApp Setup Request #<%= @request.id %>
<% end %>
<% content_for(:breadcrumb) do %>
  <%= bw_crumbs('Bloomwire', ['WhatsApp Requests', super_admin_bloomwire_whatsapp_setup_requests_path], "Request ##{@request.id}") %>
<% end %>

<div class="bw-page-head">
  <div>
    <h1 class="bw-page-title">Setup Request #<%= @request.id %></h1>
    <p class="bw-page-subtitle">Status: <%= bw_status_badge(@request.status) %></p>
  </div>
  <%= link_to 'Back', super_admin_bloomwire_whatsapp_setup_requests_path, class: 'bw-btn bw-btn--ghost' %>
</div>

<% if @request.errors.any? %>
  <div class="bw-error-state" style="margin-bottom: 16px;">
    <ul class="list-disc pl-5">
      <% @request.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="bw-card">
  <h2 class="bw-card__title">Request details</h2>
  <dl class="text-sm">
    <% {
      'Account ID' => @request.account_id,
      'Requested by (User ID)' => @request.requested_by_id,
      'Status' => @request.status.titleize,
      'Status Reason / Notes' => @request.status_reason,
      'Requested at' => @request.created_at.to_fs(:long),
      'Last updated' => @request.updated_at.to_fs(:long),
      'Completed at' => @request.completed_at
    }.each do |label, value| %>
      <div class="flex py-2.5" style="border-bottom: 1px solid var(--bw-border-soft);">
        <dt class="w-56 shrink-0" style="color: var(--bw-text-muted);"><%= label %></dt>
        <dd style="color: var(--bw-text);"><%= value.presence || '—' %></dd>
      </div>
    <% end %>
  </dl>

  <h2 class="bw-card__title" style="margin-top: 24px;">Setup mapping</h2>
  <% linked_setup_id = @request.bloomwire_whatsapp_setup_id_in_database %>
  <% if linked_setup_id.present? %>
    <p class="text-sm">
      <%= link_to 'Open setup mapping', super_admin_bloomwire_whatsapp_setup_path(linked_setup_id), class: 'bw-link' %>
      &middot;
      <%= link_to 'Open real-hop readiness', readiness_super_admin_bloomwire_whatsapp_setup_path(linked_setup_id), class: 'bw-link' %>
    </p>
  <% else %>
    <p class="text-sm" style="color: var(--bw-text-muted);">Setup mapping is still pending — none linked to this request yet.</p>
  <% end %>
</div>

<div class="bw-card">
  <h2 class="bw-card__title">Update request</h2>
  <%= form_with url: super_admin_bloomwire_whatsapp_setup_request_path(@request), method: :patch, local: true do |f| %>
    <div class="bw-field" style="max-width: 320px;">
      <label class="bw-label">Status</label>
      <%= select_tag 'bloomwire_whatsapp_setup_request[status]',
            options_for_select(Bloomwire::WhatsappSetupRequest::STATUSES.map { |s| [s.titleize, s] }, @request.status),
            class: 'bw-select' %>
    </div>
    <div class="bw-field" style="max-width: 520px;">
      <label class="bw-label">Status reason / notes (non-secret)</label>
      <%= text_area_tag 'bloomwire_whatsapp_setup_request[status_reason]', @request.status_reason, rows: 3, class: 'bw-input' %>
    </div>
    <div class="bw-field" style="max-width: 320px;">
      <label class="bw-label">Linked setup mapping ID (optional)</label>
      <%= text_field_tag 'bloomwire_whatsapp_setup_request[bloomwire_whatsapp_setup_id]', @request.bloomwire_whatsapp_setup_id, class: 'bw-input' %>
    </div>
    <%= f.submit 'Update request', class: 'bw-btn bw-btn--primary' %>
  <% end %>
</div>

<p class="bw-help" style="margin-top: 16px;">
  Real Meta credentials (app secret / verify token / access token / API key) are never part of this request
  flow and are never displayed here. Real Meta inbound testing remains a separate, externally-gated step.
</p>
