<% content_for(:title) do %>
  Provision new managed WhatsApp customer
<% end %>
<% content_for(:breadcrumb) do %>
  <%= bw_crumbs('Bloomwire', ['WhatsApp Setups', super_admin_bloomwire_whatsapp_setups_path], 'New Provision') %>
<% end %>

<div class="bw-page-head">
  <div>
    <h1 class="bw-page-title">Provision new WhatsApp customer</h1>
    <p class="bw-page-subtitle">Create a customer account and WhatsApp setup in one step. No access token is entered here.</p>
  </div>
  <%= link_to 'Back to setups', super_admin_bloomwire_whatsapp_setups_path, class: 'bw-btn bw-btn--ghost' %>
</div>

<% if @provisioning_error.present? %>
  <div class="bw-error-state" style="margin-bottom: 16px;"><div><%= @provisioning_error %></div></div>
<% end %>

<div class="bw-card" style="max-width: 640px;">
  <h2 class="bw-card__title">Account &amp; owner</h2>
  <p class="bw-card__subtitle">
    Creates an Account + Business Owner (admin) + optional Staff/Agents + a <strong>credential-less</strong>
    WhatsApp channel shell + a setup mapping (status <em>configured</em>). No Meta calls, no native webhook
    registration (inbound uses the global router), and no invitation emails — owner/agents set their password
    via the standard reset flow.
  </p>

  <%= form_with url: super_admin_bloomwire_customer_provisionings_path, method: :post do |form| %>
    <% {
      account_name: ['Account / business name', 'text'],
      owner_email: ['Business owner email (becomes administrator)', 'email'],
      owner_name: ['Business owner name (optional)', 'text'],
      agent_emails: ['Staff/agent emails (optional, comma or space separated)', 'text'],
      display_phone_number: ['WhatsApp display phone number (e.g. 15551230001)', 'text'],
      phone_number_id: ['Meta Phone Number ID (non-secret)', 'text'],
      business_account_id: ['Meta Business Account ID / WABA ID (non-secret)', 'text']
    }.each do |field, (label, type)| %>
      <div class="bw-field">
        <%= form.label "provisioning_#{field}", label, class: 'bw-label' %>
        <%= form.text_field "provisioning[#{field}]", id: "provisioning_#{field}", type: type,
              value: (@provisioning || {})[field.to_s], autocomplete: 'off', class: 'bw-input' %>
      </div>
    <% end %>

    <p class="bw-help" style="margin-bottom: 20px;">
      No API key / access token field exists here by design &mdash; credentials are entered only on the
      Channel credentials page and stored encrypted at rest.
    </p>

    <%= form.submit 'Provision customer', class: 'bw-btn bw-btn--primary' %>
  <% end %>
</div>
